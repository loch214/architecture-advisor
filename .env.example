# Copy this file to .env.local and fill in your values. .env.local is git-ignored, so keys never get committed.
# These are server-only: never rename them to NEXT_PUBLIC_..., or they'd be sent to the browser.

# off = rules only (works without any key). live = use the AI providers (needs Phase 5, the AI layer).
AI_MODE=off

# Google AI Studio key (primary AI provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# GroqCloud key (fallback AI provider)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
