# Copy this file to .env.local and fill in your values. .env.local is git-ignored, so keys never get committed.
# These are server-only: never rename them to NEXT_PUBLIC_..., or they'd be sent to the browser.

# off = rules only (works without any key). live = use the AI providers. mock = fixture replies, no quota used.
AI_MODE=off

# Google AI Studio key (primary AI provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# GroqCloud key (fallback AI provider)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional tuning (defaults shown)
# CACHE_IDENTICAL_REUSE=true   # false = identical requests also go to the AI (with the old answer as reference)
# AI_DAILY_BUDGET=1300         # AI requests per day across all users, then rules-only
# AI_MOCK=ok                   # with AI_MODE=mock: ok | invalid | slow | 429 | fail
